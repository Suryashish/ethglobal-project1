{"manifest_version":3,"name":"Silent Seal","description":"Seal a post. It opens at a set time unless you disarm it — optionally only for verified readers of chosen countries.","version":"0.1.0","icons":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","128":"icon/128.png"},"permissions":["storage","scripting","clipboardWrite"],"host_permissions":["https://x.com/*","https://twitter.com/*","https://www.reddit.com/*","https://old.reddit.com/*","http://localhost:3000/*"],"optional_host_permissions":["https://*/*","http://localhost/*","http://127.0.0.1/*"],"action":{"default_title":"Silent Seal","default_icon":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","128":"icon/128.png"},"default_popup":"popup.html"},"background":{"service_worker":"background.js"},"content_scripts":[{"matches":["http://localhost:3000/*"],"run_at":"document_start","js":["content-scripts/bridge.js"]},{"matches":["https://old.reddit.com/*","https://twitter.com/*","https://www.reddit.com/*","https://x.com/*"],"js":["content-scripts/social.js"]}]}