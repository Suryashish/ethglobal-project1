# Local full-stack overrides: arkiv-reth dev node (docker, :8645) + anvil (:8545).
# Only well-known anvil test keys here. Service keys come from .secrets/keys.env.
IIGS_DEP=local
NEXT_PUBLIC_IIGS_DEP=local
ARKIV_RPC_URL=http://localhost:8645
NEXT_PUBLIC_ARKIV_RPC_URL=http://localhost:8645
SEPOLIA_RPC_URL=http://localhost:8545
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
START_BLOCK=0
SILENT_RELEASE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_SILENT_RELEASE_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
