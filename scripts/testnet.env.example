# Testnet overlay (non-secret): Arkiv Rabdi + Ethereum Sepolia. Load AFTER .secrets/keys.env.
# Switch IIGS_DEP to "demo" for the recorded demo so test data stays separate.
IIGS_DEP=dev
NEXT_PUBLIC_IIGS_DEP=dev
NEXT_PUBLIC_ARKIV_ACCESS_KEY=   # your Arkiv access key (hub.arkiv.network/access-keys)
ARKIV_RPC_URL=
NEXT_PUBLIC_ARKIV_RPC_URL=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
START_BLOCK=12079937
SILENT_RELEASE_ADDRESS=0x03873A66518628F33180810314793551Cd97646D
NEXT_PUBLIC_SILENT_RELEASE_ADDRESS=0x03873A66518628F33180810314793551Cd97646D
NEXT_PUBLIC_WORLD_APP_ID=app_812b575cf4cd6337c321de176e2ffec6
WORLD_ACTION_OWNER=iigs-owner
WORLD_ACTION_READER=iigs-reader
NEXT_PUBLIC_WORLD_ACTION_OWNER=iigs-owner
NEXT_PUBLIC_WORLD_ACTION_READER=iigs-reader
# World ID: LIVE (real World App, production). The dev simulator exists only in scripts/local.env for automated tests.
WORLD_MODE=live
NEXT_PUBLIC_WORLD_MODE=live
WORLD_ENVIRONMENT=production
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
